{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",

  // ══════════════════════════════════════════════════════════════════
  // 宪法纪律：每条规则要么 error 且当前零违规，要么不进本文件；
  // 豁免必须点名规则并写明原因（unicorn/no-abusive-eslint-disable 强制）。
  // 修改规则 = 修宪法：x3code/* 与 oxlint-plugins/x3code/rules/ 就近测试同步修订。
  // 注：eslint 内置规则由默认插件集提供；pai/* 为本仓插件。
  // ══════════════════════════════════════════════════════════════════

  "jsPlugins": ["./oxlint-plugins/x3code/index.ts", "./oxlint-plugins/ui/index.ts"],

  "rules": {
    // ═══ 架构宪法（本仓插件：依赖白名单矩阵 + 环境面纪律）═══
    // electron 只在宿主层（apps/electron main/preload）；renderer 走 preload 桥
    "x3code/no-electron-outside-host": "error",
    // workspace 包间依赖只准按矩阵向下（contracts ← core ← infra ← api；ui/ui-thread/testkit 只认 contracts）
    "x3code/no-cross-package-imports": "error",
    // contracts/ui/renderer 环境无关：禁 node/bun 内建，系统能力一律走 Port
    "x3code/no-node-in-browser-code": "error",
    // 装死的测试写法：RNTL v14 已移除的UNSAFE_* 查询（断言永不执行却能编译）
    // + catch 绑定被 void 吞掉（失败无处可见）
    "x3code/no-dead-test-constructs": "error",

    // ═══ UI 纪律（本仓插件）═══
    // 一 .tsx 一组件/hook；嵌套定义组件/hook 禁止（每次渲染重建）
    "ui/no-multi-component": "error",

    // ═══ 封死糊弄类型系统的路（any/!/裸 ignore/动态 delete）═══
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-require-imports": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",

    // ═══ 异步与错误的真 bug 捕手 ═══
    "typescript/require-await": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-template-curly-in-string": "error",
    "promise/no-return-in-finally": "error",
    "promise/no-multiple-resolved": "error",
    "unicorn/error-message": "error",

    // ═══ 防 AI slop 与规模棘轮 ═══
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/no-abusive-eslint-disable": "error",
    "eslint/no-implicit-globals": "error",
    "eslint/no-console": "error",
    "eslint/max-lines": ["error", { "max": 500, "skipComments": true, "skipBlankLines": true }]
  },

  "overrides": [
    {
      // CLI 脚本：console 就是输出手段
      "files": ["scripts/**"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      // relay-protocol：x-harness remote-protocol 的逐字 fork（线格式真相在
      // x-harness——仓内改动会造成对拍漂移），lint 归属源仓流水线；本仓只豁免
      // 风格类断言规则，正确性由 wire-parity/ratchet/pairing 测试背书
      "files": ["packages/relay-protocol/src/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/consistent-type-imports": "off",
        "typescript/require-await": "off"
      }
    },
    {
      // shadcn 注册表生成组件：上游即单文件多导出结构，保持原样便于随注册表更新；
      // 本豁免只点名 ui/no-multi-component、只限六个生成文件（原住 renderer components/ui，
      // 下沉 packages/ui/src 根后豁免随迁），同包自研组件仍一文件一组件纪律不变
      "files": ["packages/ui/src/{button,command,dialog,input,input-group,textarea}.tsx"],
      "rules": {
        "ui/no-multi-component": "off"
      }
    }
  ],

  "ignorePatterns": ["**/out/**", "**/dist/**", "**/coverage/**"]
}
